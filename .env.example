# Copy to .env and fill in. docker compose refuses to start if a required value is missing.
# Generate random values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Required: signs login tokens. Anyone who knows it can forge an admin token.
JWT_SECRET_KEY=

# Required: database password. Use URL-safe characters (letters, digits, - _),
# because it is inserted into DATABASE_URL.
# An existing ./postgres data folder keeps the password it was created with
# (diplomtrack). Change it with ALTER USER or reset ./postgres.
POSTGRES_PASSWORD=

# Required: MinIO root credentials (also used by the backend)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional: initial admin password, used only when the admin account is first created.
# If empty, a random password is generated and printed once in the backend logs.
# The admin must change it at first login either way.
ADMIN_PASSWORD=

# SMTP (Gmail: use an app password)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
